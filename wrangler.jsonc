{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "label-lens",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}